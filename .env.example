# 必填：仅在服务端使用，不要把密钥写入前端代码
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
RATE_LIMIT_SALT=
PUBLIC_ANALYZE_DAILY_LIMIT=3
PUBLIC_REWRITE_DAILY_LIMIT=3
PUBLIC_TRANSCRIBE_DAILY_LIMIT=3
PUBLIC_AI_GLOBAL_DAILY_LIMIT=200
PUBLIC_AI_BURST_LIMIT=2
PUBLIC_AI_BURST_WINDOW_SECONDS=600
LOCAL_DOWNLOADER_URL=http://127.0.0.1:4317/download
LOCAL_TRANSCRIBER_URL=http://127.0.0.1:4318/transcribe
LOCAL_WHISPER_MODEL=base
LOCAL_WHISPER_DEVICE=cpu
LOCAL_WHISPER_COMPUTE_TYPE=int8

# 可选：转写与两种拆解模型
TRANSCRIBE_MODEL=whisper-1
ANALYSIS_MODEL=gpt-5.6-terra
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 平台视频链接需要自建或获授权的 Cobalt API。
# 音视频直链不需要配置下载服务。
COBALT_API_URL=
COBALT_API_KEY=
COBALT_AUTH_SCHEME=Api-Key

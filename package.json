{
  "name": "chaipian-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "local:setup": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"& ([scriptblock]::Create((Get-Content -Raw -Encoding UTF8 'scripts/setup-local.ps1')))\"",
    "local:downloader": "node scripts/local-downloader.mjs",
    "local:start": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"& ([scriptblock]::Create((Get-Content -Raw -Encoding UTF8 'scripts/start-local.ps1')))\"",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && node --test",
    "check": "npm run lint && npm run test",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.59.0",
    "@cloudflare/workers-types": "^5.20260924.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "drizzle-kit": "0.31.11",
    "eslint": "10.11.0",
    "eslint-config-next": "16.3.6",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vinext": "0.2.1",
    "vite": "8.3.1",
    "wrangler": "4.138.0"
  },
  "type": "module"
}
